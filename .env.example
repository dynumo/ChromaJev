# ChromaJev configuration. Every setting is an environment variable; this file
# is only a convenience for local development (`npm run dev` loads .env if it
# exists) and `docker run --env-file`. In Dokploy, set these in the UI.
# Never commit a real .env.

# ── Application ──────────────────────────────────────────────────────────
# production | development | test. The Docker image sets production.
NODE_ENV=development
# The final external URL, with no path or trailing slash. Authoritative for
# every absolute URL (emails, OAuth issuer, MCP metadata). Must be https in
# production.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Interface to bind (0.0.0.0 inside containers).
HOST=0.0.0.0
# Single persistent-data directory (SQLite database, OAuth signing keys).
# Mount a volume here. Defaults to /data in production, ./data otherwise.
DATA_DIR=./data
# Which reverse proxies to trust for X-Forwarded-* headers (Express syntax).
# Default trusts loopback and private networks (e.g. Traefik on the Docker
# network). Use a hop count like 1, or false to trust none.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ── Jev (TypeSafe) ───────────────────────────────────────────────────────
# Server-side only; never sent to browsers.
TYPESAFE_API_KEY=
# jev-latest follows TypeSafe's stable alias; pin e.g. jev-1.13.0 if you prefer.
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=20000
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# ── Initial administrator (first run only) ───────────────────────────────
# Used only when the database has no accounts at all. Never overwrites an
# existing account; you can remove these after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (Elastic Email REST API v4) ────────────────────────────────────
# elastic | log | none. Defaults to elastic when ELASTIC_EMAIL_API_KEY is set,
# otherwise log in development and none in production. "log" prints emails
# (including links) to the console and is refused in production.
# MAIL_TRANSPORT=
# API key with the "SendHttp" permission.
ELASTIC_EMAIL_API_KEY=
# Must be an address on a domain verified in Elastic Email.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ChromaJev

# ── HTTP API ─────────────────────────────────────────────────────────────
# No shared key: each user creates personal, scoped API keys on their
# Account page (Bearer cj_…). Keys act as their owner and only see their
# schemes.

# ── Optional perimeter Basic Auth ────────────────────────────────────────
# Set BOTH to put a browser Basic Auth prompt in front of the web UI.
# Setting only one is a start-up error. /health, /api, /mcp, /.well-known and
# OAuth token endpoints are exempt (they carry their own Authorization header).
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# ── MCP / OAuth authorisation server ─────────────────────────────────────
# Signing keys and cookie secrets are generated on first start and stored
# in DATA_DIR — no variables needed. These are optional tuning knobs.
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=2592000
# Dynamic Client Registration (deprecated in MCP but still used by many
# clients, e.g. Claude and ChatGPT connectors).
# OAUTH_DYNAMIC_REGISTRATION=true
# OAuth Client ID Metadata Documents (the MCP-preferred registration method).
# OAUTH_CLIENT_ID_METADATA_DOCUMENTS=true
